# WorldInMaking — environment template
# Copy:  cp .env.example .env.local
# Fill real values locally / in Cloudflare Pages. Never commit secrets.
# Docs: README.md · docs/billing.md · lib/env.ts · src/lib/bots/runtime-env.ts

# ── Required (local shell + production runtime) ─────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Server-only — never expose as NEXT_PUBLIC_*
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Public site URL (local vs production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Optional: AI providers (server / edge; BYOK also works from the browser) ─
# Primary aliases used by src/lib/bots/runtime-env.ts / ai-gateway.ts
GROQ_API_KEY=
# GROQ_API_KEY_2=          # optional rotation
# GROQ_API_KEYS=           # comma-separated rotation list
GEMINI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=   # accepted aliases for Gemini
OPENAI_API_KEY=
# NVIDIA_API_KEY=
# DEEPSEEK_API_KEY=
# Optional model overrides
# GROQ_MODEL=
# GROQ_PRIMARY_MODEL=
# GROQ_TOOL_MODEL=
# QWEN_MODEL=
# NVIDIA_MODEL=

# Web search (Ask AI live web / Tavily host fallback)
# TAVILY_API_KEY=
# BRAVE_SEARCH_API_KEY=

# ── Optional: durable rate limits / quotas (Upstash Redis REST) ─────────
# Without these, in-memory fallback is used (fine for local).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ── Optional: philosopher bots / cron (must match GitHub Actions secret) ─
# Same CRON_SECRET on Cloudflare Pages + repo secret CRON_SECRET.
CRON_SECRET=
# BOT_ACT_SECRET=          # optional alias accepted by /api/bots/act

# ── Optional: Lemon Squeezy billing (study / pro) — see docs/billing.md ─
# LEMON_SQUEEZY_API_KEY=
# LEMON_SQUEEZY_STORE_ID=
# LEMON_SQUEEZY_VARIANT_ID_PRO_MONTHLY=
# LEMON_SQUEEZY_VARIANT_ID_PRO_YEARLY=
# LEMON_SQUEEZY_WEBHOOK_SECRET=
# LEMON_SQUEEZY_DISCOUNT_CODE=WIM25

# ── Optional: storage worker (R2 / Workers AI) ──────────────────────────
# NEXT_PUBLIC_STORAGE_WORKER_URL=https://media.example.com
# STORAGE_WORKER_URL=                 # server-side alias if used

# ── Optional: analytics / admin ─────────────────────────────────────────
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# NEXT_PUBLIC_ADMIN_EMAIL=you@example.com

# ── Bootstrap / CI only ─────────────────────────────────────────────────
# SUPABASE_ACCESS_TOKEN=              # pnpm supabase:bootstrap
# SUPABASE_URL=                       # alias accepted beside NEXT_PUBLIC_SUPABASE_URL
# WIM_SKIP_ENV_HARD_FAIL=1            # CI smoke only — do not use in production

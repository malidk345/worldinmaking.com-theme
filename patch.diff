const WindowContainer = ({ children, closing }: { children: React.ReactNode; closing: boolean }) => {
    const { closeWindow } = useApp()
    const { appWindow } = useWindow()
    if (appWindow?.minimized) {
        return null
    }
    return (
        <AnimatePresence
            onExitComplete={() => {
                if (closing && appWindow) {
                    closeWindow(appWindow)
                }
            }}
        >
            {!closing && children}
        </AnimatePresence>
    )
}
